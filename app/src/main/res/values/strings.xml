    <string name="auto_settings_title">全自動擷取設定</string>
    <string name="auto_settings_desc">在蝦皮商品列表畫面點懸浮視窗的「自動」按鈕，就會依這裡的設定連續擷取多件商品，不用逐一手動點擊</string>

    <string name="target_count_label">目標擷取數量</string>

    <string name="max_attempts_label">最大嘗試次數限制</string>
    <string name="max_attempts_desc">目標數量×6（至少30次），避免篩選條件太嚴格時無止盡翻找</string>

    <string name="step_interval_label">每步驟間隔秒數（隨機區間，越大越慢但越不像機器操作）</string>
