    <!-- 原有字串（accessibility_service_config.xml 會引用，缺少會導致編譯失敗） -->
    <string name="app_name">蝦皮擷取器</string>
    <string name="accessibility_service_description">讀取畫面內容以協助自動複製推廣連結與截取商品圖片。技術上這個權限可以讀取任何最上層 App 的畫面，但本 App 只會在你主動點擊懸浮按鈕的當下才執行動作，不會自動讀取、記錄或上傳你在其他 App 裡的任何內容。</string>

    <!-- MainActivity -->
    <string name="app_title">蝦皮擷取器</string>
    <string name="app_subtitle">瀏覽到蝦皮分潤商品分享面板後，點懸浮按鈕自動複製連結並截圖商品</string>

    <string name="step1_title">開啟無障礙服務</string>
    <string name="step1_desc">允許本 App 讀取蝦皮畫面內容（僅限蝦皮，不會讀取其他 App）</string>
    <string name="btn_go_to_settings">前往設定</string>

    <string name="step_restricted_title">允許受限制的設定</string>
    <string name="step_restricted_desc">部分手機（尤其 Android 13 以上、非小米系統）會把側載安裝的 App 預設鎖住敏感設定，導致下面「開啟無障礙服務」選項變成灰色點不動、或系統自動把它關掉。請先到「應用程式詳情頁→右上角選單（⋮）→允許受限制的設定」手動點開，再繼續下面的步驟。這個開關系統不提供查詢狀態的方式，所以完成後麻煩自己勾選確認。</string>
    <string name="step_restricted_confirm_label">我已經設定過了</string>

    <string name="step2_title">允許顯示在其他 App 之上</string>
    <string name="step2_desc">讓懸浮擷取按鈕能顯示在蝦皮畫面上</string>

    <string name="step3_title">啟動懸浮按鈕</string>
    <string name="step3_desc_running">運作中，可以切到蝦皮 App 開始使用</string>
    <string name="step3_desc_idle">點擊後切換到蝦皮 App 即可看到懸浮按鈕</string>
    <string name="btn_stop">停止</string>
    <string name="btn_stop_automation">停止自動化</string>
    <string name="toast_automation_stopped_from_notification">已停止目前的自動化流程</string>
    <string name="toast_no_automation_running">目前沒有自動化流程在執行</string>
    <string name="btn_start">啟動</string>

    <string name="step_notification_title">開啟通知權限</string>
    <string name="step_notification_desc">懸浮視窗服務常駐通知（含「停止自動化」「停止」兩顆按鈕）需要這個權限才會顯示出來，沒開的話浮球被隱藏期間會完全找不到任何地方可以喊停。</string>

    <string name="step4_title">讀取相簿權限</string>
    <string name="step4_desc">分享面板下載鈕擷取原圖，需要讀取相簿才能抓到剛存下的圖片檔案。</string>
    <string name="btn_grant_permission">授予權限</string>

    <string name="step5_title">所有檔案存取權限</string>
    <string name="step5_desc">上架自動化需要讀取 CaptionQueue 底下每個商品的 meta.json，這類一般檔案沒開此權限會被系統擋掉（EACCES），影片與圖片存取不受影響。</string>

    <string name="captured_products_title">已擷取商品</string>
    <string name="btn_refresh">重新整理</string>
    <string name="empty_queue_text">還沒有擷取任何商品</string>

    <string name="region_title">蝦皮地區</string>
    <string name="region_desc">選擇你使用的蝦皮地區版本，會自動加入當地語言的按鈕文字比對（例如菲律賓版的分享／複製連結字樣），提高辨識成功率</string>

    <string name="account_title">目前使用帳號</string>
    <string name="account_desc">擷取商品時會把這個帳號名稱一併記錄下來，之後影片生成與電腦端備份會依照這個帳號分類。切換蝦皮帳號時記得回來這裡更新</string>
